# AI API Keys
# 支持的 AI 提供商：智谱、文心一言、通义千问、Kimi、DeepSeek
# 至少配置一个 API Key 才能使用 AI 功能

# 智谱 AI (https://open.bigmodel.cn/)
ZHIPU_API_KEY=your_zhipu_api_key_here

# 文心一言 (https://cloud.baidu.com/product/wenxinworkshop)
WENXIN_API_KEY=your_wenxin_api_key_here
WENXIN_ACCESS_TOKEN=your_wenxin_access_token_here

# 通义千问 (https://dashscope.aliyun.com/)
TONGYI_API_KEY=your_tongyi_api_key_here

# Kimi (https://platform.moonshot.cn/)
KIMI_API_KEY=your_kimi_api_key_here

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
